{
  "name": "App",
  "type": "module",
  "workspaces": [
    "microservicios/autentificacion",
    "microservicios/estudiantes",
    "microservicios/notificaciones",
    "microservicios/profesores",
    "gateway"
  ],
  "scripts": {
    "postinstall": "node scripts/clean-modules.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev:estudiantes": "npm run -w microservicios/estudiantes dev",
    "dev:autentificacion": "npm run -w microservicios/autentificacion dev",
    "dev:notificaciones": "npm run -w microservicios/notificaciones dev",
    "dev:profesores": "npm run -w microservicios/profesores dev",
    "dev:gateway": "npm run -w gateway dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.17",
    "drizzle-kit": "^0.18.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
