{
  "name": "app",
  "type": "module",
  "workspaces": [
    "microservicios/autentificacion",
    "microservicios/estudiantes",
    "microservicios/notificaciones",
    "microservicios/profesores",
    "microservicios/bff",
    "microservicios/cursos"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev:estudiantes": "npm run -w microservicios/estudiantes dev",
    "dev:autentificacion": "npm run -w microservicios/autentificacion dev",
    "dev:notificaciones": "npm run -w microservicios/notificaciones dev",
    "dev:profesores": "npm run -w microservicios/profesores dev",
    "dev:bff": "npm run -w microservicios/bff dev",
    "dev:cursos": "npm run -w microservicios/cursos dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "pg": "^8.20.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
